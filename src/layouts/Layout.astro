---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
// IBM Plex Sans KR은 한글 전체 유니코드 범위를 커버하느라 웨이트 하나당
// @font-face 선언이 190개(woff+woff2)씩 나온다 — 이 둘을 그냥 import하면
// Vite가 Tailwind CSS와 한 파일로 묶어버려서 최초 페인트를 막는 CSS가
// 170KB를 넘어간다(PageSpeed의 render-blocking 지적 원인). 제목에만 쓰는
// 폰트라 크리티컬하지 않으므로, ?url로 파일 경로만 가져와 아래에서
// media="print" 트릭으로 비동기 로드한다.
import ibmPlex600Url from "@fontsource/ibm-plex-sans-kr/600.css?url";
import ibmPlex700Url from "@fontsource/ibm-plex-sans-kr/700.css?url";
// 본문 전체에 쓰는 Pretendard도 사정이 있다 — IBM Plex와 달리 유니코드
// 범위별로 쪼개져 있지 않고 "latin"이라는 이름과 무관하게 한글까지 전부
// 포함한 파일 하나가 748KB(woff2)나 된다. 같은 이유로 렌더 차단에서
// 빼서 비동기로 불러온다.
import pretendard400Url from "@fontsource/pretendard/400.css?url";
import "@fontsource-variable/jetbrains-mono/wght.css";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
}

const {
  title = "FELNUT | 프론트엔드·임베디드 시스템·데이터베이스를 공부하는 고등학생 개발자 포트폴리오",
} = Astro.props;

const SITE_URL = "https://www.felnut.com/";
const DESCRIPTION =
  "프론트엔드, 임베디드 시스템, 데이터베이스를 공부하며 섯다·방화벽·액자형 공기청정기 등 다양한 프로젝트를 직접 만들어보는 FELNUT의 개발자 포트폴리오입니다. 실시간 웹 게임부터 라즈베리파이 하드웨어까지 폭넓게 다룹니다.";
const PREVIEW_IMAGE = `${SITE_URL}preview.png`;

const personId = `${SITE_URL}#person`;
const organizationId = `${SITE_URL}#organization`;
const websiteId = `${SITE_URL}#website`;
const webpageId = `${SITE_URL}#webpage`;

// git 히스토리 기준 실제 날짜(첫 커밋 / 최신 커밋). 사이트를 크게
// 개편할 때 dateModified를 그때의 커밋 날짜로 함께 갱신한다.
const PAGE_DATE_PUBLISHED = "2025-10-30";
const PAGE_DATE_MODIFIED = "2026-09-12";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "FELNUT",
      url: SITE_URL,
      image: PREVIEW_IMAGE,
      description:
        "프론트엔드, 임베디드 시스템, 데이터베이스를 공부하며 다양한 프로젝트를 개발하는 개발자입니다.",
      sameAs: ["https://github.com/felnut"],
      jobTitle: "Developer",
      knowsAbout: [
        "Frontend Development",
        "Embedded Systems",
        "Database",
        "Web Development",
        "Programming",
      ],
    },
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "FELNUT",
      url: SITE_URL,
      description:
        "프론트엔드, 임베디드 시스템, 데이터베이스를 공부하며 다양한 프로젝트를 개발하는 1인 개발자입니다.",
      logo: `${SITE_URL}imgs/small_logo.png`,
      // 실제 사업장 주소가 없는 1인 개발 프로젝트라, schema.org가
      // address에 Text도 허용하는 점을 이용해 포트폴리오 사이트
      // URL을 대신 넣는다.
      address: SITE_URL,
      founder: { "@id": personId },
      sameAs: ["https://github.com/felnut"],
      contactPoint: {
        "@type": "ContactPoint",
        email: "dev@felnut.com",
        contactType: "customer support",
      },
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: SITE_URL,
      name: "FELNUT",
      description: DESCRIPTION,
      inLanguage: "ko-KR",
      publisher: { "@id": organizationId },
    },
    {
      "@type": "WebPage",
      "@id": webpageId,
      url: SITE_URL,
      name: title,
      description: DESCRIPTION,
      inLanguage: "ko-KR",
      isPartOf: { "@id": websiteId },
      about: { "@id": personId },
      primaryImageOfPage: PREVIEW_IMAGE,
      datePublished: PAGE_DATE_PUBLISHED,
      dateModified: PAGE_DATE_MODIFIED,
    },
  ],
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta
      name="keywords"
      content="FELNUT, 개발자 포트폴리오, 프론트엔드 개발자, 임베디드 시스템, 웹 개발, 프로그래밍, 데이터베이스"
    />
    <meta name="author" content="FELNUT" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#101010" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 원본 로고(512x512, 128KB)는 브라우저 탭 아이콘용으로는 과한
         용량이라, 매 페이지 로드마다 받는 파비콘은 48x48로 축소한 것을
         쓴다. 원본은 JSON-LD의 Organization.logo 등 큰 해상도가 필요한
         곳에만 그대로 남겨둔다. -->
    <link rel="icon" type="image/png" href="/imgs/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={SITE_URL} />

    <!-- 제목에만 쓰는 IBM Plex Sans KR은 렌더 차단 없이 비동기로 불러오고,
         로드되기 전까지는 폴백 폰트로 보여준다(media="print" 트릭). -->
    <!-- 본문 폰트 Pretendard도 748KB짜리 단일 파일이라 같은 방식으로
         비동기 로드한다 — 폴백 폰트로 먼저 보여주고 로드되면 교체. -->
    <link rel="preload" as="style" href={ibmPlex600Url} />
    <link rel="preload" as="style" href={ibmPlex700Url} />
    <link rel="preload" as="style" href={pretendard400Url} />
    <link rel="stylesheet" href={ibmPlex600Url} media="print" onload="this.media='all'" />
    <link rel="stylesheet" href={ibmPlex700Url} media="print" onload="this.media='all'" />
    <link rel="stylesheet" href={pretendard400Url} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={ibmPlex600Url} />
      <link rel="stylesheet" href={ibmPlex700Url} />
      <link rel="stylesheet" href={pretendard400Url} />
    </noscript>

    <meta name="naver-site-verification" content="b2b312a7dfe81100d7893247fa9b6d29fda95084" />
    <meta name="google-site-verification" content="MBoj6hKvAKFle602kZORdUkT7hrYkKWearSyGvV67s4" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:image" content={PREVIEW_IMAGE} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FELNUT" />
    <meta property="og:locale" content="ko_KR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={PREVIEW_IMAGE} />

    <!-- Structured Data (JSON-LD) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body class="bg-(--background) px-9 sm:px-28 lg:px-20">
    <Analytics />
    <SpeedInsights />
    <slot />
  </body>
</html>

<style is:global>
  /* Pretendard/IBM Plex Sans KR는 media="print" 트릭으로 비동기 로드되다 보니,
     로드 전엔 폴백 폰트(Arial 등)로 그려지고 로드 후 실제 폰트로 교체(swap)된다.
     두 폰트의 줄 높이(ascent/descent)가 폴백과 달라 교체 시 아래 콘텐츠가
     밀리는 레이아웃 시프트(CLS)가 생기므로, 폴백에 실제 폰트와 같은 세로
     메트릭을 강제로 씌워 교체 전후 줄 상자 높이를 맞춘다. 수치는 각 폰트
     파일의 hhea ascent/descent를 unitsPerEm으로 나눠 계산(fonttools로 직접 측정). */
  @font-face {
    font-family: "Pretendard Fallback";
    src: local("Arial");
    ascent-override: 95.21%;
    descent-override: 24.12%;
    line-gap-override: 0%;
  }

  @font-face {
    font-family: "IBM Plex Sans KR Fallback";
    src: local("Arial");
    ascent-override: 108.5%;
    descent-override: 41.5%;
    line-gap-override: 0%;
  }

  /* Tailwind v4 utilities live in @layer utilities, which always loses to
     unlayered CSS regardless of source order — so this reset has to sit in
     @layer base too, or it would permanently win over every utility class
     (e.g. body's px-9). */
  @layer base {
    :root {
      --background: #101010;
      --sec: #a476ff;
      --white: #dfdfdf;
      --white-icon: #cbd5e1;
      --white-icon-tr: #f3f3f310;
      --font-heading: "IBM Plex Sans KR", "IBM Plex Sans KR Fallback", -apple-system, system-ui, sans-serif;
      --font-body: "Pretendard", "Pretendard Fallback", -apple-system, system-ui, sans-serif;
      --font-mono: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, monospace;
    }

    * {
      font-family: var(--font-body);
      box-sizing: border-box;
      padding: 0;
      margin: 0;
    }

    h1,
    h2,
    h3,
    h4,
    nav {
      font-family: var(--font-heading);
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    p,
    li,
    span {
      letter-spacing: -0.005em;
    }

    nav span,
    nav a {
      letter-spacing: -0.01em;
    }

    *::selection {
      background-color: var(--sec);
      color: var(--background);
    }

    /* Scrollbar styles */

    ::-webkit-scrollbar {
      width: 15px;
    }

    ::-webkit-scrollbar-track {
      background: var(--container);
      border-radius: 30px;
    }

    ::-webkit-scrollbar-thumb {
      background: var(--background);
      border-radius: 10px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: var(--pink);
    }

    /* Scrollbar styles for Firefox */
    * {
      scrollbar-width: thin;
      scrollbar-color: var(--line) var(--container);
    }
  }
</style>
