---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Home from "@/components/home.astro";
import Projects from "@/components/projects.astro";
import Contact from "@/components/contact.astro";
import Footer from "@/components/footer.astro";
---

<Layout>
  <Nav />
  <main>
    <Home />
    <Projects />
    <section
      aria-labelledby="notes-title"
      class="mx-auto max-w-5xl border-t border-[#ffffff10] py-12 text-(--white)"
    >
      <h2 id="notes-title" class="mb-4 text-3xl">
        개발 노트
      </h2>
      <p class="mb-6 text-(--white-icon)">
        포트폴리오를 고치면서 바뀐 코드와 그 이유를 기록합니다.
      </p>
      <ul class="space-y-4 text-(--sec)">
        <li>
          <a href="/notes/portfolio-design/" class="underline underline-offset-4">
            포트폴리오에서 제일 어려웠던 건 무엇을 넣을지 정하는 일이었다 →
          </a>
        </li>
        <li>
          <a href="/notes/static-portfolio/" class="underline underline-offset-4">
            한글 폰트를 늦게 불러온 뒤, 글이 밀리기 시작했다 →
          </a>
        </li>
        <li>
          <a href="/notes/navigation/" class="underline underline-offset-4">
            페이지를 늘리자 ‘프로젝트’ 메뉴가 멈췄다 →
          </a>
        </li>
      </ul>
      <a href="/notes/" class="mt-6 inline-block text-(--white-icon) underline underline-offset-4">
        개발 노트 전체 보기
      </a>
    </section>
    <Contact />
  </main>
  <Footer />
</Layout>
