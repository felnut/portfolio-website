---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Home from "@/components/home.astro";
import Projects from "@/components/projects.astro";
import Contact from "@/components/contact.astro";
import Footer from "@/components/footer.astro";
---

<Layout>
  <Nav />
  <main>
    <Home />
    <Projects />
    <section
      aria-labelledby="notes-title"
      class="mx-auto max-w-5xl border-t border-[#ffffff10] py-12 text-(--white)"
    >
      <h2 id="notes-title" class="mb-4 text-3xl">
        코드로 읽는 개발 노트
      </h2>
      <p class="mb-6 text-(--white-icon)">
        이 포트폴리오의 구현과 수정 과정을 공개 소스와 함께 설명합니다.
      </p>
      <ul class="space-y-4 text-(--sec)">
        <li>
          <a href="/notes/static-portfolio/" class="underline underline-offset-4">
            Astro 정적 페이지와 React의 역할 →
          </a>
        </li>
        <li>
          <a href="/notes/navigation/" class="underline underline-offset-4">
            상세 페이지에서 홈 메뉴가 작동하지 않는 이유 →
          </a>
        </li>
      </ul>
      <a href="/notes/" class="mt-6 inline-block text-(--white-icon) underline underline-offset-4">
        개발 노트 전체 보기
      </a>
    </section>
    <Contact />
  </main>
  <Footer />
</Layout>
