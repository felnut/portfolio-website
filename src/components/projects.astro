---
import PreparingButton from "../React/PreparingButton.tsx";
import GitHubIcon from "../components/icons/GitHubIcon.astro";

interface Project {
  title: string;
  emoji: string;
  description: string;
  details?: { title: string; items: string[] };
  status: string;
  githubUrl: string | null;
  // githubUrl이 null일 때 보여줄 안내 문구 — 이유가 프로젝트마다 다르다
  // (아직 안 올림 / 저장소가 비공개라 공개 링크가 없음 등).
  githubNotice?: string;
  // 실제로 배포되어 있는 프로젝트만 채운다.
  liveUrl?: string;
}

const projects: Project[] = [
  {
    title: "섯다",
    emoji: "🃏",
    description: "전통 카드 게임 섯다를 친구와 온라인 실시간으로 즐길 수 있는 웹 게임입니다.",
    details: {
      title: "주요 기능",
      items: ["Socket.IO 기반 실시간 멀티플레이", "구글 로그인 및 랭킹", "AI 상대와 대전"],
    },
    status: "완료",
    githubUrl: "https://github.com/felnut/Seotda",
    liveUrl: "https://seotda.felnut.com",
  },
  {
    title: "방화벽 프로젝트",
    emoji: "🧱",
    description: "파이썬을 활용하여 방화벽의 원리를 알아보았습니다.",
    status: "완료",
    githubUrl: "https://github.com/felnut/Firewall-Project",
  },
  {
    title: "날씨 친구",
    emoji: "🌥️",
    description: "원하는 이미지를 날씨에 맞추어 넣으면, 날씨에 따라 이미지를 띄워줍니다.",
    details: {
      title: "사용 API",
      items: ["OpenWeatherMap", "Kakao Map"],
    },
    status: "완료",
    // 저장소가 비공개라 공개 링크를 걸 수 없음(Yoast SEO 체크에서 404로
    // 잡힌 원인).
    githubUrl: null,
    githubNotice: "비공개 저장소라 공개 링크가 없습니다.",
  },
  {
    title: "액자형 공기청정기",
    emoji: "🖼️",
    description: "액자식 공기청정기를 라즈베리파이로 제작하였습니다.",
    details: {
      title: "특징",
      items: ["액자식 형태로 공간 차지 최소화", "디자인에 잘 어울리고 분위기 저하 감소"],
    },
    status: "완료",
    githubUrl: null,
  },
];

const linkIconClass =
  "size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]";
---

<section id="projects" class="border-t border-[#ffffff10] py-12 text-[var(--white)]">
  <div class="mx-auto max-w-5xl">
    <h2 class="shiny-sec mb-2 text-lg text-[var(--sec)]">My work</h2>
    <h3 class="mb-8 text-4xl font-bold md:text-5xl">Projects</h3>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {projects.map((project) => (
        <div class="group">
          <div class="mb-4 flex h-48 items-center justify-center overflow-hidden rounded-2xl border border-[var(--white-icon-tr)] bg-gradient-to-br from-[#241a38] to-[#1a1428] shadow-lg md:h-72">
            <span
              class="text-7xl transition-transform duration-300 group-hover:scale-110 md:text-8xl"
              aria-hidden="true"
            >
              {project.emoji}
            </span>
          </div>

          <div class="px-3">
            <div class="flex items-start">
              <div class="min-w-0 flex-grow">
                <h4 class="text-2xl font-semibold">{project.title}</h4>
                <span class="block py-1 text-sm text-[var(--white-icon)]">{project.status}</span>
              </div>

              <div class="ml-auto flex shrink-0 gap-2">
                {project.githubUrl ? (
                  <a
                    target="_blank"
                    rel="noopener noreferrer"
                    href={project.githubUrl}
                    aria-label={`${project.title} GitHub 저장소 열기`}
                    class={linkIconClass}
                  >
                    <GitHubIcon class="size-7" />
                  </a>
                ) : (
                  <PreparingButton
                    client:load
                    className={linkIconClass}
                    message={project.githubNotice}
                  />
                )}

                {project.liveUrl && (
                  <a
                    target="_blank"
                    rel="noopener noreferrer"
                    href={project.liveUrl}
                    aria-label={`${project.title} 사이트 방문하기`}
                    class={linkIconClass}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="size-7"
                    >
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  </a>
                )}
              </div>
            </div>

            <p class="mt-3 text-sm leading-relaxed text-[var(--white-icon)]">
              {project.description}
            </p>

            {project.details && (
              <div class="mt-2 text-sm text-[var(--white-icon)]">
                <span>{project.details.title}: </span>
                <span>{project.details.items.join(" · ")}</span>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://github.com/felnut"
      class="mt-9 flex w-full items-center justify-center gap-2 rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] p-3 text-[var(--white-icon)] transition duration-300 ease-in-out hover:scale-105 hover:bg-[var(--white-icon-tr)] hover:text-white"
    >
      <span class="text-md md:text-lg">더 많은 프로젝트 보러가기</span>
      <GitHubIcon class="size-6" />
    </a>
  </div>
</section>
