---
import EmailLink from "../React/EmailLink.tsx";
import GitHubIcon from "../components/icons/GitHubIcon.astro";
import EmailIcon from "../components/icons/EmailIcon.astro";

const linkCardClass =
  "group flex items-center gap-3 rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] px-6 py-3 font-semibold text-[var(--white-icon)] transition-all duration-300 hover:-translate-y-1 hover:text-white hover:border-white/20";
---

<section id="contact" class="w-full border-t border-[#ffffff10] py-12">
  <div class="mx-auto max-w-5xl">
    <h2 class="shiny-sec mb-2 text-lg text-[var(--sec)]">Let's talk</h2>
    <h3 class="mb-6 text-4xl font-bold text-[var(--white)] md:text-5xl">Contact</h3>

    <p class="mb-8 text-[var(--white-icon)]">
      궁금한 점이나 협업 제안이 있다면 편하게 연락해주세요. 사이드 프로젝트나 스터디 제안도
      환영하며, 이메일이나 디스코드로 남겨주시면 최대한 빠르게 답장 드리겠습니다.
    </p>

    <nav aria-label="연락 및 소셜 미디어 링크" class="flex flex-wrap items-center gap-4">
      <EmailLink client:visible ariaLabel="FELNUT에게 Email 보내기" className={linkCardClass}>
        <EmailIcon width="1.4em" height="1.4em" />
        Email
      </EmailLink>

      <a
        href="https://github.com/felnut"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="FELNUT GitHub 프로필 열기"
        class={linkCardClass}
      >
        <GitHubIcon class="size-6" />
        GitHub
      </a>

      <a
        href="https://discord.com/users/901664081801535489"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="FELNUT Discord 프로필 열기"
        class={linkCardClass}
      >
        <img src="/imgs/discord.svg" alt="" aria-hidden="true" class="size-6 invert" />
        Discord
      </a>
    </nav>
  </div>
</section>
