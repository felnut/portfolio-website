---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
import EmailLink from "../React/EmailLink.tsx";

const socialIconClass =
  "text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]";

// 기존 사이트(About.jsx)와 같은 계산 — 생년월일/코딩 공부 시작일은 실제 값.
function calculateAge() {
  const today = new Date();
  const birthDate = new Date(2008, 3, 21); // 2008년 4월 21일
  let age = today.getFullYear() - birthDate.getFullYear();
  const hasNotHadBirthday =
    today.getMonth() < birthDate.getMonth() ||
    (today.getMonth() === birthDate.getMonth() && today.getDate() < birthDate.getDate());
  if (hasNotHadBirthday) age--;
  return age;
}

function calculateCareer() {
  const today = new Date();
  const startDate = new Date(2022, 1, 1); // 2022년 2월 1일
  let years = today.getFullYear() - startDate.getFullYear();
  const hasNotReachedAnniversary =
    today.getMonth() < startDate.getMonth() ||
    (today.getMonth() === startDate.getMonth() && today.getDate() < startDate.getDate());
  if (hasNotReachedAnniversary) years--;
  return years;
}

const age = calculateAge();
const career = calculateCareer();
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:py-36 pb-14">
    <div class="text-left space-y-4">
      <p class="text-md md:text-lg text-[var(--white-icon)] shiny-white">안녕하세요, FELNUT입니다</p>
      <div class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 md:gap-4">
        <h1 class="text-[var(--white)] text-5xl md:text-6xl font-medium text-pretty leading-none">개발자</h1>
        <p class="text-md md:text-2xl text-[var(--white-icon)]">
          프론트엔드, 임베디드 시스템, 데이터베이스를 공부하며 다양한 프로젝트를 만들어가고 있습니다. 그중에서도{" "}
          <span class="text-[var(--sec)] shiny-sec">프론트엔드</span> 개발에 가장 큰 흥미를 느낍니다.
        </p>
      </div>
      <div class="flex justify-start gap-2 pt-3 md:pt-6">
        <a target="_blank" href="https://github.com/felnut" aria-label="GitHub" class={socialIconClass}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8">
            <path
              d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
            ></path>
          </svg>
        </a>

        <EmailLink client:load ariaLabel="Email" className={socialIconClass}>
          <svg xmlns="http://www.w3.org/2000/svg" width="2.1em" height="2.1em" viewBox="0 0 24 24">
            <path
              fill="currentColor"
              d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
            ></path>
          </svg>
        </EmailLink>

        <a
          target="_blank"
          href="https://discord.com/users/901664081801535489"
          aria-label="Discord"
          class={socialIconClass}
        >
          <img src="/imgs/discord.svg" alt="" aria-hidden="true" class="size-8 invert" />
        </a>
      </div>
    </div>

    <LogoWall />

    <div class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6 md:p-8">
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">About Me</h2>
      <h3 class="text-2xl md:text-3xl font-medium mb-4">저를 소개합니다</h3>

      <p class="text-[var(--white-icon)] leading-relaxed">
        안녕하세요! 개발자 <span class="text-[var(--white)] font-semibold">FELNUT</span>입니다.{" "}
        <span class="text-[var(--white)] font-semibold">프론트엔드</span>,{" "}
        <span class="text-[var(--white)] font-semibold">임베디드 시스템</span>,{" "}
        <span class="text-[var(--white)] font-semibold">데이터베이스</span>를 공부하고 있습니다.
      </p>

      <div aria-label="FELNUT에 대한 정보" class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div
          aria-label={`${age}세`}
          class="rounded-xl border border-[var(--white-icon-tr)] bg-[#1a1a1a9c] p-4 text-center"
        >
          <p aria-hidden="true" class="text-3xl font-bold text-[var(--sec)]">{age}세</p>
          <p class="text-xs md:text-sm text-[var(--white-icon)]">고등학생</p>
        </div>

        <div
          aria-label={`코딩 공부 ${career}년`}
          class="rounded-xl border border-[var(--white-icon-tr)] bg-[#1a1a1a9c] p-4 text-center"
        >
          <p aria-hidden="true" class="text-3xl font-bold text-[var(--sec)]">{career}년</p>
          <p class="text-xs md:text-sm text-[var(--white-icon)]">코딩 공부</p>
        </div>
      </div>
    </div>

    <div class="flex flex-col lg:flex-row items-center gap-8">
      <SkillsList client:load />
      <div class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16">
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
