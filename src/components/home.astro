---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
import EmailLink from "../React/EmailLink.tsx";
import GitHubIcon from "../components/icons/GitHubIcon.astro";
import EmailIcon from "../components/icons/EmailIcon.astro";

const socialIconClass =
  "text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]";

// 기존 사이트(About.jsx)와 같은 계산 — 생년월일/코딩 공부 시작일은 실제 값.
function calculateAge() {
  const today = new Date();
  const birthDate = new Date(2008, 3, 21); // 2008년 4월 21일
  let age = today.getFullYear() - birthDate.getFullYear();
  const hasNotHadBirthday =
    today.getMonth() < birthDate.getMonth() ||
    (today.getMonth() === birthDate.getMonth() && today.getDate() < birthDate.getDate());
  if (hasNotHadBirthday) age--;
  return age;
}

function calculateCareer() {
  const today = new Date();
  const startDate = new Date(2022, 1, 1); // 2022년 2월 1일
  let years = today.getFullYear() - startDate.getFullYear();
  const hasNotReachedAnniversary =
    today.getMonth() < startDate.getMonth() ||
    (today.getMonth() === startDate.getMonth() && today.getDate() < startDate.getDate());
  if (hasNotReachedAnniversary) years--;
  return years;
}

const age = calculateAge();
const career = calculateCareer();
---

<section class="mt-12 text-[var(--white)] md:mt-0" id="home">
  <div class="mx-auto max-w-5xl space-y-8 pb-14 md:py-36">
    <div class="space-y-4 text-left">
      <p class="text-md shiny-white text-[var(--white-icon)] md:text-lg">
        안녕하세요, FELNUT입니다
      </p>
      <div
        class="flex flex-col space-y-4 md:gap-4 lg:flex-row lg:items-center lg:space-x-8 lg:space-y-0"
      >
        <h1
          class="shrink-0 text-pretty text-5xl font-bold leading-none text-[var(--white)] md:text-6xl"
        >
          개발자
        </h1>
        <p class="text-md text-[var(--white-icon)] md:text-2xl">
          프론트엔드, 임베디드 시스템, 데이터베이스를 공부하며 다양한 프로젝트를 만들어가고
          있습니다. 그중에서도{" "}
          <span class="shiny-sec text-[var(--sec)]">프론트엔드</span> 개발에 가장 큰 흥미를 느낍니다.
        </p>
      </div>
      <div class="flex justify-start gap-2 pt-3 md:pt-6">
        <a
          target="_blank"
          href="https://github.com/felnut"
          aria-label="GitHub"
          class={socialIconClass}
        >
          <GitHubIcon class="size-8" />
        </a>

        <EmailLink client:load ariaLabel="Email" className={socialIconClass}>
          <EmailIcon />
        </EmailLink>

        <a
          target="_blank"
          href="https://discord.com/users/901664081801535489"
          aria-label="Discord"
          class={socialIconClass}
        >
          <img src="/imgs/discord.svg" alt="" aria-hidden="true" class="size-8 invert" />
        </a>
      </div>
    </div>

    <LogoWall />

    <div class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6 md:p-8">
      <h2 class="shiny-sec mb-2 text-lg text-[var(--sec)]">About Me</h2>
      <h3 class="mb-4 text-2xl md:text-3xl">저를 소개합니다</h3>

      <p class="leading-relaxed text-[var(--white-icon)]">
        안녕하세요! 개발자 <span class="font-semibold text-[var(--white)]">FELNUT</span>입니다.{" "}
        <span class="font-semibold text-[var(--white)]">프론트엔드</span>,{" "}
        <span class="font-semibold text-[var(--white)]">임베디드 시스템</span>,{" "}
        <span class="font-semibold text-[var(--white)]">데이터베이스</span>를 공부하고 있습니다.
      </p>

      <div aria-label="FELNUT에 대한 정보" class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div
          aria-label={`${age}세`}
          class="rounded-xl border border-[var(--white-icon-tr)] bg-[#1a1a1a9c] p-4 text-center"
        >
          <p
            aria-hidden="true"
            class="font-[family-name:var(--font-heading)] text-3xl font-bold tracking-[-0.01em] text-[var(--sec)]"
          >
            {age}세
          </p>
          <p class="text-xs text-[var(--white-icon)] md:text-sm">고등학생</p>
        </div>

        <div
          aria-label={`코딩 공부 ${career}년`}
          class="rounded-xl border border-[var(--white-icon-tr)] bg-[#1a1a1a9c] p-4 text-center"
        >
          <p
            aria-hidden="true"
            class="font-[family-name:var(--font-heading)] text-3xl font-bold tracking-[-0.01em] text-[var(--sec)]"
          >
            {career}년
          </p>
          <p class="text-xs text-[var(--white-icon)] md:text-sm">코딩 공부</p>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center gap-8 lg:flex-row">
      <SkillsList client:load />
      <div class="flex size-[290px] justify-center pt-3 md:ml-16 md:h-[292px] md:w-full md:pt-9">
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
