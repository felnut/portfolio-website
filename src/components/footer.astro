---
import EmailLink from "../React/EmailLink.tsx";
import GitHubIcon from "../components/icons/GitHubIcon.astro";
import EmailIcon from "../components/icons/EmailIcon.astro";

const currentYear = new Date().getFullYear();

const iconClass =
  "text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out";
---

<footer class="w-full border-t border-[#ffffff10] py-12">
  <div class="mx-auto max-w-5xl">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <div class="flex flex-col items-center gap-6 lg:items-start">
        <div class="flex gap-6 sm:gap-8">
          <a
            href="https://github.com/felnut"
            target="_blank"
            rel="noopener noreferrer"
            class={`flex flex-col items-center group ${iconClass}`}
            aria-label="GitHub"
          >
            <GitHubIcon class="size-8" />
          </a>

          <EmailLink
            client:load
            ariaLabel="Email"
            className={`group flex flex-col items-center ${iconClass}`}
          >
            <EmailIcon />
          </EmailLink>

          <a
            href="https://discord.com/users/901664081801535489"
            target="_blank"
            rel="noopener noreferrer"
            class={`flex flex-col items-center group ${iconClass}`}
            aria-label="Discord"
          >
            <img src="/imgs/discord.svg" alt="" aria-hidden="true" class="size-8 invert" />
          </a>
        </div>
      </div>

      <div class="flex flex-col items-center space-y-6 lg:items-end">
        <div class="grid w-full max-w-xs grid-cols-1 gap-3 py-6">
          {
            [
              { desc: "Built with", name: "Astro", icon: "/svg/astro.svg", alt: "Astro Logo" },
              {
                desc: "Styled with",
                name: "TailwindCSS",
                icon: "/svg/tailwindcss.svg",
                alt: "TailwindCSS Logo",
              },
              { desc: "Deployed on", name: "Vercel", icon: "/svg/vercel.svg", alt: "Vercel Logo" },
            ].map((tech) => (
              <div class="flex items-center justify-center space-x-3 lg:justify-end">
                <span class="text-sm text-[var(--white-icon)]">{tech.desc}</span>
                <img
                  src={tech.icon}
                  alt={tech.alt}
                  class="h-5 w-5 object-contain opacity-50 brightness-0 invert filter"
                  loading="lazy"
                />
                <span class="text-sm text-[var(--white-icon)]">{tech.name}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-[#ffffff10] pt-8">
      <p class="text-center text-sm text-[var(--white-icon)]">
        © {currentYear} FELNUT. All rights reserved. <br class="sm:hidden" />
        <br />Design based on{" "}
        <a
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--white-icon)] underline underline-offset-2 transition duration-300 ease-in-out hover:text-[var(--white)]"
          href="https://themewagon.com/themes/dark-minimal/"
        >
          DarkMinimal
        </a>{" "}
        by{" "}
        <a
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--white-icon)] underline underline-offset-2 transition duration-300 ease-in-out hover:text-[var(--white)]"
          href="https://github.com/Gothsec"
        >
          Andres Hernandez
        </a>
      </p>
    </div>
  </div>
</footer>

<button
  id="scroll-to-top"
  type="button"
  aria-label="맨 위로 가기"
  class="fixed bottom-24 right-4 z-50 flex size-11 items-center justify-center rounded-full border border-[#ffffff10] bg-[var(--background)] text-[var(--white-icon)] opacity-0 shadow-lg pointer-events-none translate-y-2 transition-all duration-300 ease-in-out hover:text-[var(--white)] md:bottom-8 md:right-8"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
    <path d="M13 7.82843V20H11V7.82843L5.63604 13.1924L4.22183 11.7782L12 4L19.7782 11.7782L18.364 13.1924L13 7.82843Z"
    ></path>
  </svg>
</button>

<style>
  #scroll-to-top.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
</style>

<script>
  const scrollTopButton = document.getElementById("scroll-to-top");
  let rafId: number | null = null;

  function updateScrollTopButton() {
    scrollTopButton?.classList.toggle("visible", window.scrollY > 400);
    rafId = null;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!rafId) {
        rafId = requestAnimationFrame(updateScrollTopButton);
      }
    },
    { passive: true },
  );

  updateScrollTopButton();

  scrollTopButton?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
